# Copy this file to .env and fill in the secrets used by the application.
MEALIE_BASE_URL=http://192.168.2.33:9925
MEALIE_TOKEN=REPLACE_ME
LLM_PROVIDER=openai
LLM_MODEL=gpt-4o-mini
LLM_API_KEY=REPLACE_ME
LLM_TEMPERATURE=0.2
LLM_MAX_TOKENS=4096
LLM_VISION_MODEL=gpt-5-mini
LLM_TIMEOUT=120
INGREDIENT_FUZZY_THRESHOLD=90
INGREDIENT_CACHE_DIR=data/cache
INGREDIENT_DEFAULT_CATEGORY=Sonstiges
INGREDIENT_DEFAULT_CATEGORY_COLOR=#959595
INGREDIENT_USE_LLM_CLASSIFIER=true

FROM python:3.11-slim AS base
ENV PYTHONDONTWRITEBYTECODE=1 \
    PYTHONUNBUFFERED=1
WORKDIR /app

# System deps for Pillow and pypdf
RUN apt-get update && \
    apt-get install -y --no-install-recommends \
      build-essential \
      libjpeg62-turbo-dev \
      zlib1g-dev \
      libfreetype6-dev \
      libwebp-dev \
      libopenjp2-7-dev \
      libtiff5 && \
    rm -rf /var/lib/apt/lists/*

COPY requirements.txt ./
RUN pip install --no-cache-dir -r requirements.txt

# Copy application code
COPY importer ./importer
COPY config ./config
COPY settings.yaml ./settings.yaml
COPY data ./data

EXPOSE 8000

CMD ["uvicorn", "importer.server:app", "--host", "0.0.0.0", "--port", "8000"]

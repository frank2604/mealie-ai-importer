FROM python:3.11-slim AS base
ENV PYTHONDONTWRITEBYTECODE=1 \
    PYTHONUNBUFFERED=1
WORKDIR /app

COPY requirements.txt ./
RUN pip install --no-cache-dir -r requirements.txt

# Copy application code
# Application code
COPY importer ./importer
COPY config ./config
COPY config/settings.template.yaml ./config/settings.yaml
COPY config/prompts.json ./config/prompts.json

# Ensure runtime directories exist; actual content is mounted via volumes
RUN mkdir -p /app/data/cache /app/data/uploads /app/data/archive /app/data/pipeline

EXPOSE 8000

CMD ["uvicorn", "importer.server:app", "--host", "0.0.0.0", "--port", "8000"]

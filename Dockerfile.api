FROM python:3.11-slim AS base
ENV PYTHONDONTWRITEBYTECODE=1 \
    PYTHONUNBUFFERED=1
WORKDIR /app

COPY requirements.txt ./
RUN pip install --no-cache-dir -r requirements.txt

# Pre-download the local embedding model into a non-mounted path so semantic
# ingredient matching works fully offline at runtime. /opt is used instead of
# /app/data because the data directory is bind-mounted at runtime and would
# otherwise shadow the baked-in model weights.
ENV FASTEMBED_CACHE_PATH=/opt/fastembed_cache
# Retry the model download: HuggingFace throttles anonymous pulls, so a single
# attempt fails intermittently and breaks the whole build. Up to 5 tries.
RUN n=0; until python -c "from fastembed import TextEmbedding; TextEmbedding('sentence-transformers/paraphrase-multilingual-mpnet-base-v2')"; do \
        n=$((n+1)); \
        if [ "$n" -ge 5 ]; then echo "Embedding model download failed after $n attempts" >&2; exit 1; fi; \
        echo "Model download attempt $n failed, retrying in 20s..." >&2; sleep 20; \
    done

# Copy application code
# Application code
COPY importer ./importer
COPY config ./config
COPY config/settings.template.yaml ./config/settings.yaml
COPY config/prompts.json ./config/prompts.json

# Ensure runtime directories exist; actual content is mounted via volumes
RUN mkdir -p /app/data/cache /app/data/uploads /app/data/archive /app/data/pipeline

# Never phone home for model weights at runtime; the model is already baked in.
ENV HF_HUB_OFFLINE=1

EXPOSE 8000

CMD ["uvicorn", "importer.server:app", "--host", "0.0.0.0", "--port", "8000"]

  "instructions": [
    {
      "steps": [
        {
          "order": 1,
          "instruction": "Hähnchenbrustfilets mit Salz und Pfeffer würzen.",
          "ingredientIds": [],
          "ingredientReferenceIds": []
        },
        {
          "order": 2,
          "instruction": "Jeweils ein Salbeiblatt auf jedes Filet legen und die Filets mit Parma-Schinken umwickeln.",
          "ingredientIds": [],
          "ingredientReferenceIds": []
        },
        {
          "order": 3,
          "instruction": "Fett in einer Pfanne erhitzen. Die Filets leicht mit Mehl bestäuben und rundherum kurz anbraten, bis sie Farbe nehmen.",
          "ingredientIds": [],
          "ingredientReferenceIds": []
        },
        {
          "order": 4,
          "instruction": "Die angebratenen Filets herausnehmen und in eine feuerfeste Form legen.",
          "ingredientIds": [],
          "ingredientReferenceIds": []
        },
        {
          "order": 5,
          "instruction": "Zwiebeln schälen und klein hacken. In derselben Pfanne die Zwiebeln zusammen mit den geviertelten Champignons anbraten.",
          "ingredientIds": [],
          "ingredientReferenceIds": []
        },
        {
          "order": 6,
          "instruction": "Mit Wermut ablöschen, etwas einkochen lassen und dann die süße Sahne angießen.",
          "ingredientIds": [],
          "ingredientReferenceIds": []
        },
        {
          "order": 7,
          "instruction": "Den hellen Soßenbinder einrühren, die Soße kurz aufkochen lassen und mit Salz und Pfeffer abschmecken.",
          "ingredientIds": [],
          "ingredientReferenceIds": []
        },
        {
          "order": 8,
          "instruction": "Die Soße über die Hähnchenbrustfilets in der Form gießen.",
          "ingredientIds": [],
          "ingredientReferenceIds": []
        },
        {
          "order": 9,
          "instruction": "Die Form in den vorgeheizten Ofen geben und alles bei 200 °C etwa 20 Minuten garen lassen.",
          "timer_minutes": 20,

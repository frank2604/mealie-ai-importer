  "id": "f5bcb078-454c-4d67-87da-a6f4a2a0117e",
  "lastMade": null,
  "name": "Hähnchenbrust im Parma-Schinken mit Champignon-Sahne-Wermut-Soße (1)",
  "slug": "hahnchenbrust-im-parma-schinken-mit-champignon-sahne-wermut-sosse-1",
  "orgURL": "data/uploads/d6595dc2221a4288b495bdf0d3c2116d.pdf",
  "dateAdded": "2025-11-18",
  "assets": [],
  "recipeYield": "4 Portionen",
  "updatedAt": "2025-11-18T07:42:06.637836Z",
  "image": null,
  "description": "Zarte Hähnchenbrustfilets werden mit Salbeiblättern belegt, in Parmaschinken gewickelt und kurz angebraten. Eine cremige Champignon-Sahne-Soße mit Wermut rundet das Gericht ab und wird im Ofen fertig gegart. Dazu passen Pellkartoffeln und ein frischer grüner Salat.",
  "cookTime": null,
  "recipeServings": 4.0,
  "userId": "48ff7261-817a-43a9-89de-63ee69dd4a3e",
  "tools": [],
  "groupId": "5977364f-4465-4f7a-b672-b97ab1801232",
  "createdAt": "2025-11-18T07:41:56.443918Z",
  "recipeInstructions": [
    {
      "id": "21f84893-2488-46a5-94bc-72dc0aa04dac",
      "text": "Hähnchenbrustfilets mit Salz und Pfeffer würzen.",
      "order": 1,
      "ingredientReferences": [
        "ing-0-0",
        "ing-0-10",
        "ing-0-11"
      ]
    },
    {
      "id": "716d63fc-49ef-4a49-9e07-7a131b52f15c",
      "text": "Jeweils ein Salbeiblatt auf jedes Filet legen und die Filets mit Parma-Schinken umwickeln.",
      "order": 2,
      "ingredientReferences": [
        "ing-0-1"
      ]
    },
    {
      "id": "a46b2b69-60b3-4048-afba-48cf7d9660d0",
      "text": "Fett in einer Pfanne erhitzen. Die Filets leicht mit Mehl bestäuben und rundherum kurz anbraten, bis sie Farbe nehmen.",
      "order": 3,
      "ingredientReferences": [
        "ing-0-6",
        "ing-0-8"
      ]
    },
    {
      "id": "e6cf313a-ed4e-4e6a-8cee-ad067c474206",
      "text": "Die angebratenen Filets herausnehmen und in eine feuerfeste Form legen.",
      "order": 4,
      "ingredientReferences": []
    },
    {
      "id": "420a9905-aa96-4eb7-b9c8-a5d63c2bf848",
      "text": "Zwiebeln schälen und klein hacken. In derselben Pfanne die Zwiebeln zusammen mit den geviertelten Champignons anbraten.",
      "order": 5,
      "ingredientReferences": [
        "ing-0-2"
      ]
    },
    {
      "id": "0060b550-7a19-4e6d-bf8e-dbae54d66f41",
      "text": "Mit Wermut ablöschen, etwas einkochen lassen und dann die süße Sahne angießen.",
      "order": 6,
      "ingredientReferences": [
        "ing-0-5"
      ]
    },
    {
      "id": "9a369d42-b2f5-4234-80a9-0626ee8174da",
      "text": "Den hellen Soßenbinder einrühren, die Soße kurz aufkochen lassen und mit Salz und Pfeffer abschmecken.",
      "order": 7,
      "ingredientReferences": [
        "ing-0-10",
        "ing-0-11",
        "ing-0-7"
      ]
    },
    {
      "id": "9b51f27a-2376-40e8-a652-211ab9fb07e9",
      "text": "Die Soße über die Hähnchenbrustfilets in der Form gießen.",
      "order": 8,
      "ingredientReferences": [
        "ing-0-0"
      ]
    },
    {
      "id": "548c4c61-bb6d-4e03-a2ac-744376aa569f",
      "text": "Die Form in den vorgeheizten Ofen geben und alles bei 200 °C etwa 20 Minuten garen lassen.",
      "order": 9,
      "ingredientReferences": [],
      "timerMinutes": 20
    },
    {
      "id": "26738345-13b4-4a07-98b3-08af28526753",
      "text": "Herausnehmen und heiß servieren.",
      "order": 10,
      "ingredientReferences": []
    }
  ]
}
    "recipeInstructions": [
      {
        "id": "4fd33f9b-78c9-43d9-b4bd-9031f8fccc18",
        "title": null,
        "summary": null,
        "text": "Fleisch mit Haushaltspapier trocken tupfen. Porree putzen und in feine Ringe schneiden. Knoblauchzehe schälen und würfeln. Orangen dick schälen, weiße Teile entfernen und in einzelne Filets teilen.",
        "ingredientReferences": []
      },
      {
        "id": "5476793b-d233-4199-a0cd-da4dc3f356db",
        "title": null,
        "summary": null,
        "text": "Butterschmalz in einer Pfanne erhitzen. Hähnchenbrustfilets im heißen Fett auf jeder Seite etwa 4 Minuten kräftig anbraten, herausnehmen und warm stellen.",
        "ingredientReferences": []
      },
      {
        "id": "e32ae6d9-eedb-4cc5-bf91-47bd84a13377",
        "title": null,
        "summary": null,
        "text": "Knoblauch im Bratfett andünsten. Orangensaft und Sherry zugeben und etwas einkochen lassen.",
        "ingredientReferences": []
      },
      {
        "id": "40cd31cd-f77b-4148-ba93-44b4c1afe26e",
        "title": null,
        "summary": null,
        "text": "Mit Salz abschmecken und die Wasabipaste einrühren, bis die Sauce gleichmäßig gewürzt ist.",
        "ingredientReferences": []
      },
      {
        "id": "940f3ae8-d95e-499b-bbc6-b4f5f52ea6af",
        "title": null,
        "summary": null,
        "text": "Hähnchenbrustfilets und Porree in die Sauce legen und etwa 5 Minuten ziehen lassen, damit Fleisch und Lauch die Aromen aufnehmen.",
        "ingredientReferences": []
      },
      {
        "id": "f8846fa7-3beb-4754-9417-2232c692052a",
        "title": null,
        "summary": null,
        "text": "Orangenfilets zugeben und alles mit gehacktem Koriander bestreuen. Nach Belieben mit Basmatireis servieren.",
        "ingredientReferences": []
      }
    ],
    "nutrition": {
      "calories": null,

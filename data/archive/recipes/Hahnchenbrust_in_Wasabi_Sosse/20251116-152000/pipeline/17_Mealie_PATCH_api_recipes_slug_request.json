  "name": "Hähnchenbrust in Wasabi-Sauce (1)",
  "recipeInstructions": [
    {
      "id": "4f1f82a0-24af-4e12-bf4c-f3108f780f97",
      "text": "Fleisch abtupfen. Porree putzen und in feine Ringe schneiden. Knoblauch abziehen und würfeln. Orangen dick schälen, weiße Teile entfernen und in einzelne Filets teilen. Koriander grob hacken.",
      "order": 1,
      "ingredientReferences": []
    },
    {
      "id": "3960b5de-1fd7-4baa-972a-c041bb11b15e",
      "text": "Hähnchenbrustfilets im heißen Butterschmalz pro Seite 4 Minuten anbraten, dann herausnehmen und warm stellen.",
      "order": 2,
      "ingredientReferences": [],
      "timerMinutes": 4
    },
    {
      "id": "a62f6b62-f8f0-442f-af79-e6f5bb77138b",
      "text": "Knoblauch im Bratfett andünsten. Orangensaft und Sherry hinzufügen und etwas einkochen lassen.",
      "order": 3,
      "ingredientReferences": []
    },
    {

  "name": "Hähnchenbrustfilet im Schinkenmantel",
  "tools": [],
  "recipeInstructions": [
    {
      "id": "e5735ccd-1c78-4db2-921c-a7d784305b28",
      "text": "Hähnchenbrustfilets mit Pfeffer würzen.",
      "order": 1,
      "ingredientReferences": []
    },
    {
      "id": "d8ac3a16-8fbf-4e0d-93c0-43d20aecad62",
      "text": "Jeweils ein Salbeiblatt auf die Filets legen und die Filets mit Parma-Schinken umwickeln.",
      "order": 2,
      "ingredientReferences": []
    },
    {
      "id": "877af872-cfcb-4fef-b160-a4316070319b",
      "text": "Fett in einer Pfanne erhitzen, die Filets leicht mit Mehl bestäuben und rundherum anbraten, bis sie Farbe bekommen.",
      "order": 3,
      "ingredientReferences": []
    },
    {
      "id": "56334e38-5b95-448b-bd98-6ad873779076",
      "text": "Die angebratenen Filets herausnehmen und in eine feuerfeste Form legen.",
      "order": 4,
      "ingredientReferences": []
    },
    {
      "id": "25d3f2aa-5cac-43d7-8721-af809b7058d4",
      "text": "Zwiebeln schälen und klein hacken, Champignons putzen und vierteln. Beides in der Pfanne anbraten.",
      "order": 5,
      "ingredientReferences": []
    },
    {
      "id": "f45de6d9-bc0e-4924-b35a-0bde2d2d5fc1",
      "text": "Mit Wermut ablöschen, etwas einkochen lassen und dann die süße Sahne angießen.",
      "order": 6,
      "ingredientReferences": []
    },
    {
      "id": "c29718f1-003f-4767-85b3-93b85b37fb22",
      "text": "Den hellen Soßenbinder einrühren, die Sauce kurz aufkochen lassen und mit Salz und Pfeffer abschmecken.",
      "order": 7,
      "ingredientReferences": []
    },
    {
      "id": "6bade1c9-e1e0-4487-849a-759f4702bf23",
      "text": "Die Sauce über die Filets in der Form gießen und alles im vorgeheizten Ofen bei 200 °C etwa 20 Minuten garen lassen.",
      "order": 8,
      "ingredientReferences": [],
      "timerMinutes": 20
    },
    {
      "id": "83e617f3-80d0-4e35-8274-17311018a509",
      "text": "Aus dem Ofen nehmen und kurz ruhen lassen.",
      "order": 9,
      "ingredientReferences": []
    }
  ]
}
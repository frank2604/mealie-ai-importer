  "recipeInstructions": [
    {
      "id": "c9cb06d8-7d6d-43c3-a684-4297efbdc043",
      "text": "Hähnchenbrustfilets pfeffern. Jeweils mit einem Salbeiblatt belegen und mit Parma-Schinken umwickeln.",
      "order": 1,
      "ingredientReferences": []
    },
    {
      "id": "c8364656-2c97-45d7-a53d-f376e9f7e126",
      "text": "Fett in einer Pfanne erhitzen. Die Filets mit Mehl bestäuben und rundherum anbraten, dann herausnehmen und in eine feuerfeste Form legen.",
      "order": 2,
      "ingredientReferences": []
    },
    {
      "id": "52749912-d6e4-4f02-a104-4323efd8b304",
      "text": "Zwiebeln schälen und kleinhacken. Zusammen mit den geputzten, geviertelten Champignons in derselben Pfanne anbraten.",
      "order": 3,
      "ingredientReferences": []
    },
    {
      "id": "553676c9-71ca-4854-bdfd-a7dae1739cd2",
      "text": "Mit Wermut ablöschen, etwas einkochen lassen und dann die süße Sahne angießen. Den hellen Soßenbinder einrühren, kurz aufkochen lassen und die Soße mit Salz und Pfeffer abschmecken.",
      "order": 4,
      "ingredientReferences": []
    },
    {
      "id": "66cf98fb-c673-4c74-83a4-d039fa8a1366",

    "recipeInstructions": [
      {
        "id": "7ec0b291-de77-4e5f-8f27-6d3212b9faa7",
        "title": null,
        "summary": null,
        "text": "Die Hähnchenbrustfilets mit Pfeffer würzen. Jeweils ein Salbeiblatt auf die Filets legen und jedes Filet mit einer Scheibe Parma-Schinken umwickeln.",
        "ingredientReferences": []
      },
      {
        "id": "9ada76a1-b273-438a-be7d-b6bbe98aed19",
        "title": null,
        "summary": null,
        "text": "Fett in einer Pfanne erhitzen. Die Filets leicht mit Mehl bestäuben und rundherum anbraten, bis sie Farbe nehmen. Herausnehmen und in eine feuerfeste Form legen.",
        "ingredientReferences": []
      },
      {
        "id": "ff0c1ed0-9427-4811-97cf-90360c983210",
        "title": null,
        "summary": null,
        "text": "Zwiebeln schälen und klein hacken. Zusammen mit den geputzten und geviertelten Champignons in der Pfanne anbraten, bis sie leicht gebräunt sind.",
        "ingredientReferences": []
      },
      {
        "id": "dc23bd75-fce6-4832-acde-9c183ffac6d2",
        "title": null,
        "summary": null,
        "text": "Mit dem trockenen Wermut ablöschen, etwas einkochen lassen und dann die süße Sahne angießen. Den hellen Soßenbinder einrühren und die Soße kurz aufkochen lassen. Mit Salz und Pfeffer abschmecken.",
        "ingredientReferences": []
      },
      {
        "id": "eafde6be-18cd-4403-a2be-9c942d14383b",
        "title": null,
        "summary": null,
        "text": "Die Soße über die Hähnchenbrustfilets in der feuerfesten Form geben und alles im vorgeheizten Ofen bei 200° C etwa 20 Minuten garen lassen.",
        "ingredientReferences": []
      },
      {
        "id": "437c389e-19e9-4b55-9015-5e93c5385c3d",
        "title": null,
        "summary": null,
        "text": "Die Filets aus dem Ofen nehmen und heiß servieren.",
        "ingredientReferences": []

    "recipeInstructions": [
      {
        "id": "a2c9d85a-f87d-40da-977e-442c93a064b3",
        "title": null,
        "summary": null,
        "text": "Hähnchenbrustfilets mit Salz und Pfeffer würzen.",
        "ingredientReferences": []
      },
      {
        "id": "39983395-8d55-4fd6-8548-76f05bf5f0b8",
        "title": null,
        "summary": null,
        "text": "Jeweils ein Salbeiblatt auf ein Filet legen und die Filets mit Parma-Schinken umwickeln.",
        "ingredientReferences": []
      },
      {
        "id": "22665b7a-ccde-419b-a90d-108f1d725cca",
        "title": null,
        "summary": null,
        "text": "Fett in einer Pfanne erhitzen. Die Filets leicht mit Mehl bestäuben und in der Pfanne von beiden Seiten anbraten, bis sie Farbe bekommen.",
        "ingredientReferences": []
      },
      {
        "id": "c1571677-4fd9-40de-acde-67e9acfea701",
        "title": null,
        "summary": null,
        "text": "Die angebratenen Filets aus der Pfanne nehmen und in eine feuerfeste Form legen.",
        "ingredientReferences": []
      },
      {
        "id": "9853f6a1-4b86-4932-aa4a-9166d32b0c9a",
        "title": null,
        "summary": null,
        "text": "Zwiebeln schälen, klein hacken. Champignons putzen und vierteln.",
        "ingredientReferences": []
      },
      {
        "id": "38ca9886-9402-4206-b460-87abc16aeab6",
        "title": null,
        "summary": null,
        "text": "Zwiebeln und Champignons in derselben Pfanne anbraten, bis sie leicht gebräunt sind.",
        "ingredientReferences": []
      },
      {
        "id": "79ffe599-a4fa-4a07-9bf1-2d2725a98ba1",
        "title": null,
        "summary": null,
        "text": "Mit trockenem Wermut ablöschen, etwas einkochen lassen und anschließend die süße Sahne angießen.",
        "ingredientReferences": []
      },
      {

    "recipeInstructions": [
      {
        "id": "6ef90922-793a-40a9-8e93-0eee109be67d",
        "title": null,
        "summary": null,
        "text": "Hähnchenbrustfilets mit Pfeffer würzen. Jeweils ein Salbeiblatt auf ein Filet legen und mit je einer oder mehreren Scheiben Parma-Schinken umwickeln, sodass das Filet bedeckt ist.",
        "ingredientReferences": [
          {
            "referenceId": null
          },
          {
            "referenceId": null
          },
          {
            "referenceId": null
          }
        ]
      },
      {
        "id": "4250c8e9-66a8-40c9-8071-70378832f9ac",
        "title": null,
        "summary": null,
        "text": "Fett in einer Pfanne erhitzen. Die umwickelten Filets leicht mit Mehl bestäuben und in der Pfanne von allen Seiten kurz anbraten, bis sie Farbe bekommen.",
        "ingredientReferences": [
          {
            "referenceId": null
          },
          {
            "referenceId": null
          }
        ]
      },
      {
        "id": "1ad96c17-f2ae-4336-b86a-06bf7d5dd1d0",
        "title": null,
        "summary": null,
        "text": "Die angebratenen Filets aus der Pfanne nehmen und in eine feuerfeste Form legen.",
        "ingredientReferences": []
      },
      {
        "id": "53d7909b-3928-4999-b1bb-6bc9f7e34743",
        "title": null,
        "summary": null,
        "text": "Zwiebeln schälen und fein hacken. In derselben Pfanne die Zwiebeln zusammen mit den geputzten und geviertelten Champignons anbraten, bis sie leicht gebräunt sind.",
        "ingredientReferences": [
          {
            "referenceId": null
          }
        ]
      },
      {
        "id": "c007e208-1d12-439b-8013-311ccfdd101f",
        "title": null,
        "summary": null,

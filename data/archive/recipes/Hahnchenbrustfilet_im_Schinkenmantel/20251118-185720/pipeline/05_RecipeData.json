  "instructions": [
    {
      "name": null,
      "steps": [
        {
          "id": "step-0-0",
          "order": 1,
          "instruction": "Hähnchenbrustfilets mit Salz und Pfeffer würzen. Je ein Salbeiblatt auf jedes Filet legen und die Filets jeweils mit Parma‑Schinken umwickeln.",
          "timer_minutes": null,
          "ingredientIds": [
            "ing-0-0",
            "ing-0-1",
            "ing-0-10",
            "ing-0-11"
          ],
          "ingredientReferenceIds": []
        },
        {
          "id": "step-0-1",
          "order": 2,
          "instruction": "Fett in einer Pfanne erhitzen. Die Filets leicht mit Mehl bestäuben und von beiden Seiten anbraten, bis sie Farbe bekommen. Die angebratenen Filets herausnehmen und in eine feuerfeste Form legen.",
          "timer_minutes": null,
          "ingredientIds": [
            "ing-0-6",
            "ing-0-8"
          ],
          "ingredientReferenceIds": []
        },
        {
          "id": "step-0-2",
          "order": 3,
          "instruction": "Zwiebeln schälen und kleinhacken. In derselben Pfanne Zwiebeln zusammen mit den geputzten und geviertelten Champignons anbraten, bis sie leicht gebräunt sind.",
          "timer_minutes": null,
          "ingredientIds": [
            "ing-0-2"
          ],
          "ingredientReferenceIds": []
        },
        {
          "id": "step-0-3",
          "order": 4,
          "instruction": "Mit dem Wermut ablöschen und etwas einreduzieren lassen. Dann die süße Sahne angießen und den hellen Soßenbinder einrühren. Die Sauce kurz aufkochen lassen und mit Salz und Pfeffer abschmecken.",
          "timer_minutes": null,
          "ingredientIds": [
            "ing-0-5",
            "ing-0-10",
            "ing-0-11"
          ],
          "ingredientReferenceIds": []
        },
        {
          "id": "step-0-4",
          "order": 5,
          "instruction": "Die Sauce über die Filets in der feuerfesten Form gießen und alles im vorgeheizten Ofen bei 200 °C etwa 20 Minuten garen lassen.",
          "timer_minutes": 20,
          "ingredientIds": [],
          "ingredientReferenceIds": []
        },
        {
          "id": "step-0-5",
          "order": 6,
          "instruction": "Zum Servieren die Filets mit der Sauce anrichten. Dazu passen Pellkartoffeln und ein grüner Salat.",
          "timer_minutes": null,
          "ingredientIds": [],
          "ingredientReferenceIds": []
        }
      ]
    }
  ],
  "notes": "Das Gericht lässt sich gut vorbereiten: Filets vorbereiten und anbraten, Sauce zubereiten und alles kurz vor dem Servieren im Ofen fertig garen. Dazu passen Pellkartoffeln und grüner Salat.",

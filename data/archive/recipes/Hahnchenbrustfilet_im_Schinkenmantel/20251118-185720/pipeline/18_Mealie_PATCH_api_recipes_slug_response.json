    "recipeInstructions": [
      {
        "id": "5d718663-5649-4562-b429-1cab8c6f1f72",
        "title": null,
        "summary": null,
        "text": "Hähnchenbrustfilets mit Salz und Pfeffer würzen. Je ein Salbeiblatt auf jedes Filet legen und die Filets jeweils mit Parma‑Schinken umwickeln.",
        "ingredientReferences": [
          {
            "referenceId": null
          },
          {
            "referenceId": null
          },
          {
            "referenceId": null
          },
          {
            "referenceId": null
          }
        ]
      },
      {
        "id": "e420703c-d2f4-4d10-8103-3d80e420525a",
        "title": null,
        "summary": null,
        "text": "Fett in einer Pfanne erhitzen. Die Filets leicht mit Mehl bestäuben und von beiden Seiten anbraten, bis sie Farbe bekommen. Die angebratenen Filets herausnehmen und in eine feuerfeste Form legen.",
        "ingredientReferences": [
          {
            "referenceId": null
          },
          {
            "referenceId": null
          }
        ]
      },
      {
        "id": "dd7a6cb7-9e14-4f22-af91-85c605967962",
        "title": null,
        "summary": null,
        "text": "Zwiebeln schälen und kleinhacken. In derselben Pfanne Zwiebeln zusammen mit den geputzten und geviertelten Champignons anbraten, bis sie leicht gebräunt sind.",
        "ingredientReferences": [
          {
            "referenceId": null
          }
        ]
      },
      {
        "id": "d58d2343-7bc8-48de-9eeb-5d0172bf1068",
        "title": null,
        "summary": null,
        "text": "Mit dem Wermut ablöschen und etwas einreduzieren lassen. Dann die süße Sahne angießen und den hellen Soßenbinder einrühren. Die Sauce kurz aufkochen lassen und mit Salz und Pfeffer abschmecken.",
        "ingredientReferences": [
          {
            "referenceId": null
          },
          {
            "referenceId": null
          },
          {
            "referenceId": null
          }
        ]
      },

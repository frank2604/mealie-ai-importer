  "instructions": [
    {
      "name": null,
      "steps": [
        {
          "id": "step-0-0",
          "order": 1,
          "instruction": "Hähnchenbrustfilets pfeffern.",
          "timer_minutes": null,
          "ingredientIds": [
            "ing-0-0",
            "ing-0-11"
          ],
          "ingredientReferenceIds": []
        },
        {
          "id": "step-0-1",
          "order": 2,
          "instruction": "Jeweils mit einem Salbeiblatt belegen und mit Schinken umwickeln.",
          "timer_minutes": null,
          "ingredientIds": [
            "ing-0-0",
            "ing-0-9",
            "ing-0-1"
          ],
          "ingredientReferenceIds": []
        },
        {
          "id": "step-0-2",
          "order": 3,
          "instruction": "Fett in einer Pfanne erhitzen, die Filets mit Mehl bestäuben und anbraten.",
          "timer_minutes": null,
          "ingredientIds": [
            "ing-0-8",
            "ing-0-0",
            "ing-0-6"
          ],
          "ingredientReferenceIds": []
        },
        {
          "id": "step-0-3",
          "order": 4,
          "instruction": "Filets herausnehmen und in eine feuerfeste Form geben.",
          "timer_minutes": null,
          "ingredientIds": [],
          "ingredientReferenceIds": []
        },
        {
          "id": "step-0-4",
          "order": 5,
          "instruction": "Zwiebeln schälen, kleinhacken und zusammen mit den geputzten, geviertelten Champignons anbraten.",
          "timer_minutes": null,
          "ingredientIds": [
            "ing-0-3",
            "ing-0-2",
            "ing-0-8"
          ],
          "ingredientReferenceIds": []
        },
        {
          "id": "step-0-5",
          "order": 6,
          "instruction": "Mit Wermut ablöschen, etwas einkochen lassen und Sahne angießen.",
          "timer_minutes": null,
          "ingredientIds": [
            "ing-0-4",
            "ing-0-5"
          ],
          "ingredientReferenceIds": []
        },
        {
          "id": "step-0-6",
          "order": 7,
          "instruction": "1 EL Soßenbinder einrühren, kurz aufkochen lassen und mit Salz und Pfeffer abschmecken.",
          "timer_minutes": null,
          "ingredientIds": [
            "ing-0-7",
            "ing-0-10",
            "ing-0-11"
          ],
          "ingredientReferenceIds": []
        },
        {
          "id": "step-0-7",
          "order": 8,
          "instruction": "Die Soße über das Fleisch in der Form geben und alles etwa 20 Minuten bei 200° C garen lassen.",
          "timer_minutes": 20,
          "ingredientIds": [
            "ing-0-0"
          ],
          "ingredientReferenceIds": []
        }
      ]
    }
  ],
  "notes": "Dazu passen Pellkartoffeln und grüner Salat.",

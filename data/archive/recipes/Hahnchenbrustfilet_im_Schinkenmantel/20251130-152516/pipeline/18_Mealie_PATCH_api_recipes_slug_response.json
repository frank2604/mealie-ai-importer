    "recipeInstructions": [
      {
        "id": "7326adb1-5589-4743-8fbb-3b32283b3072",
        "title": null,
        "summary": null,
        "text": "Hähnchenbrustfilets pfeffern.",
        "ingredientReferences": [
          {
            "referenceId": "12400bc8-bbb4-4bd9-a953-5cea0a433841"
          },
          {
            "referenceId": "17ee1772-cc2b-4621-9df6-a8f99285b064"
          }
        ]
      },
      {
        "id": "7af9e485-4439-4f69-8906-1ec6866ac7a5",
        "title": null,
        "summary": null,
        "text": "Jeweils mit einem Salbeiblatt belegen und mit Schinken umwickeln.",
        "ingredientReferences": [
          {
            "referenceId": "63746bd8-d885-4da5-8105-e68e6cf0cf9a"
          },
          {
            "referenceId": "f1760b33-bddd-4d94-a42f-5e7b05d21344"
          }
        ]
      },
      {
        "id": "66f2b360-e1a0-4d97-bed5-d9cd81ef1e48",
        "title": null,
        "summary": null,
        "text": "Fett in einer Pfanne erhitzen, die Filets mit Mehl bestäuben und anbraten.",
        "ingredientReferences": [
          {
            "referenceId": "b524e577-56b1-40a2-80bd-12d2b3c6aa6a"
          },
          {
            "referenceId": "12400bc8-bbb4-4bd9-a953-5cea0a433841"
          },
          {
            "referenceId": "501a035a-6281-44ff-9581-1709ff918e51"
          }
        ]
      },
      {
        "id": "448ecd8f-1325-4d04-86d4-57ba6076bf3a",
        "title": null,
        "summary": null,
        "text": "Herausnehmen und in eine feuerfeste Form geben.",
        "ingredientReferences": []
      },
      {
        "id": "00cb6e64-85cc-4768-b376-f0bb90dac3ff",
        "title": null,
        "summary": null,
        "text": "Zwiebeln schälen und kleinhacken und zusammen mit den geputzten, geviertelten Champignons anbraten.",
        "ingredientReferences": [
          {
            "referenceId": "aac7310a-2a1a-464c-b1e4-d72e70b32a51"
          },
          {
            "referenceId": "7d0010d8-b858-438f-8ea9-635d7f404937"
          }
        ]
      },
      {
        "id": "3499b399-c76b-4018-8e79-8d3ed833dd66",
        "title": null,
        "summary": null,
        "text": "Mit Wermut ablöschen, etwas einkochen lassen und Sahne angießen.",
        "ingredientReferences": [
          {
            "referenceId": "f0cbfd23-7e28-478f-9042-4f25bc737831"
          },
          {
            "referenceId": "9e50e78e-7b18-440f-8f6f-2bd2bcc22b19"
          }
        ]
      },
      {
        "id": "9a9e2ac6-0983-424e-98ad-25e09c4394a3",
        "title": null,
        "summary": null,
        "text": "1 EL Soßenbinder einrühren, kurz aufkochen lassen und mit Salz und Pfeffer abschmecken.",
        "ingredientReferences": [
          {
            "referenceId": "ca22cb51-052e-4777-8373-30647aad40a0"
          },
          {
            "referenceId": "06d480f9-080f-4d6a-a048-d05715e4f411"
          },
          {
            "referenceId": "17ee1772-cc2b-4621-9df6-a8f99285b064"
          }
        ]

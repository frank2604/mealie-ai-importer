  "instructions": [
    {
      "name": null,
      "steps": [
        {
          "order": 1,
          "instruction": "Hähnchenbrustfilets mit Salz und Pfeffer würzen. Jeweils ein Salbeiblatt auf die Filets legen und mit einer oder mehreren Scheiben Parma-Schinken umwickeln.",
          "timer_minutes": null
        },
        {
          "order": 2,
          "instruction": "Fett in einer Pfanne erhitzen. Die Filets leicht mit Mehl bestäuben und von beiden Seiten anbraten, bis sie Farbe nehmen. Herausnehmen und in eine feuerfeste Form legen.",
          "timer_minutes": null
        },
        {
          "order": 3,
          "instruction": "Zwiebeln schälen und kleinhacken. In derselben Pfanne Zwiebeln und die geviertelten Champignons anbraten, bis sie leicht gebräunt sind.",
          "timer_minutes": null
        },
        {
          "order": 4,
          "instruction": "Mit dem trockenen Wermut ablöschen, etwas einkochen lassen und dann die süße Sahne zugießen. Den hellen Soßenbinder einrühren, die Soße kurz aufkochen lassen und mit Salz und Pfeffer abschmecken.",
          "timer_minutes": null
        },
        {
          "order": 5,
          "instruction": "Die Soße über die Hähnchenfilets in der feuerfesten Form geben. Im vorgeheizten Backofen bei 200 °C etwa 20 Minuten garen lassen.",
          "timer_minutes": 20
        },
        {
          "order": 6,
          "instruction": "Aus dem Ofen nehmen und servieren. Dazu passen Pellkartoffeln und grüner Salat.",
          "timer_minutes": null
        }
      ]
    }
  ],
  "notes": "Backofen 200 °C. Als Beilage passen Pellkartoffeln und grüner Salat. Menge reicht für etwa 4 Portionen.",

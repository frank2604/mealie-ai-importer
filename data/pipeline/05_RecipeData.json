  "instructions": [
    {
      "name": null,
      "steps": [
        {
          "id": "step-0-0",
          "order": 1,
          "instruction": "Die Hähnchenbrustfilets mit Pfeffer würzen. Jeweils ein Salbeiblatt auf jedes Filet legen und die Filets mit Parma-Schinken umwickeln.",
          "timer_minutes": null,
          "ingredientIds": [
            "ing-0-0",
            "ing-0-1",
            "ing-0-11"
          ],
          "ingredientReferenceIds": []
        },
        {
          "id": "step-0-1",
          "order": 2,
          "instruction": "Fett in einer Pfanne erhitzen. Die Filets leicht mit Mehl bestäuben und rundherum anbraten, bis sie Farbe bekommen.",
          "timer_minutes": null,
          "ingredientIds": [
            "ing-0-6"
          ],
          "ingredientReferenceIds": []
        },
        {
          "id": "step-0-2",
          "order": 3,
          "instruction": "Die angebratenen Filets aus der Pfanne nehmen und in eine feuerfeste Form legen.",
          "timer_minutes": null,
          "ingredientIds": [],
          "ingredientReferenceIds": []
        },
        {
          "id": "step-0-3",
          "order": 4,
          "instruction": "Zwiebeln schälen und klein hacken. Zwiebeln zusammen mit den geputzten und geviertelten Champignons in der Pfanne anbraten.",
          "timer_minutes": null,
          "ingredientIds": [
            "ing-0-2"
          ],
          "ingredientReferenceIds": []
        },
        {
          "id": "step-0-4",
          "order": 5,
          "instruction": "Mit Wermut ablöschen, etwas einkochen lassen und dann die süße Sahne angießen. Den hellen Soßenbinder einrühren, kurz aufkochen lassen und die Soße mit Salz und Pfeffer abschmecken.",
          "timer_minutes": null,
          "ingredientIds": [
            "ing-0-5",
            "ing-0-10",
            "ing-0-11"
          ],
          "ingredientReferenceIds": []
        },
        {
          "id": "step-0-5",
          "order": 6,
          "instruction": "Die Soße über die Hähnchenfilets in der Form gießen und alles im vorgeheizten Backofen bei 200 °C etwa 20 Minuten garen lassen.",
          "timer_minutes": 20,
          "ingredientIds": [],
          "ingredientReferenceIds": []
        },
        {
          "id": "step-0-6",
          "order": 7,
          "instruction": "Die Hähnchenfilets aus dem Ofen nehmen und servieren. Dazu passen Pellkartoffeln und grüner Salat.",
          "timer_minutes": null,
          "ingredientIds": [],
          "ingredientReferenceIds": []
        }
      ]
    }
  ],
  "notes": "Dazu passen Pellkartoffeln und grüner Salat. Die Garzeit kann je nach Ofen und Dicke der Filets variieren.",

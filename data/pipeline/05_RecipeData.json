  "instructions": [
    {
      "name": null,
      "steps": [
        {
          "order": 1,
          "instruction": "Hähnchenbrustfilets mit Pfeffer würzen. Jeweils ein Salbeiblatt auf das Filet legen und das Filet mit je eineinhalb Scheiben Parma-Schinken (insgesamt eine Scheibe pro Seite) oder einer Scheibe umwickeln.",
          "timer_minutes": null
        },
        {
          "order": 2,
          "instruction": "Fett in einer Pfanne erhitzen. Die umwickelten Filets leicht mit Mehl bestäuben und von allen Seiten kurz anbraten, bis sie Farbe bekommen.",
          "timer_minutes": null
        },
        {
          "order": 3,
          "instruction": "Die angebratenen Filets aus der Pfanne nehmen und in eine feuerfeste Form legen.",
          "timer_minutes": null
        },
        {
          "order": 4,
          "instruction": "Zwiebeln schälen und klein hacken. Die Champignons putzen und vierteln. Beides in der Pfanne anbraten, bis sie leicht gebräunt sind.",
          "timer_minutes": null
        },
        {
          "order": 5,
          "instruction": "Mit trockenem Wermut ablöschen und etwas einkochen lassen, damit der Alkohol verkocht.",
          "timer_minutes": null
        },
        {
          "order": 6,
          "instruction": "Sahne angießen und den hellen Soßenbinder einrühren. Die Soße kurz aufkochen lassen und mit Salz und Pfeffer abschmecken.",
          "timer_minutes": null
        },
        {
          "order": 7,
          "instruction": "Die Soße über die Hähnchenbrustfilets in der feuerfesten Form gießen.",
          "timer_minutes": null
        },
        {
          "order": 8,
          "instruction": "Die Form in den auf 200° C vorgeheizten Backofen geben und das Gericht etwa 20 Minuten garen, bis das Hähnchen durchgegart ist.",
          "timer_minutes": 20
        },
        {
          "order": 9,
          "instruction": "Herausnehmen und heiß servieren. Dazu passen Pellkartoffeln und ein grüner Salat.",
          "timer_minutes": null
        }
      ]
    }
  ],
  "notes": "Als Beilage passen Pellkartoffeln und grüner Salat sehr gut. Bei Bedarf die Soße mit etwas mehr Soßenbinder andicken oder mit Muskatnuss verfeinern.",

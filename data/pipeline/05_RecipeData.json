  "instructions": [
    {
      "name": null,
      "steps": [
        {
          "order": 1,
          "instruction": "Hähnchenbrustfilets mit Salz und Pfeffer würzen.",
          "timer_minutes": null
        },
        {
          "order": 2,
          "instruction": "Jeweils ein Salbeiblatt auf ein Filet legen und das Filet mit einer Scheibe Parma-Schinken umwickeln.",
          "timer_minutes": null
        },
        {
          "order": 3,
          "instruction": "Fett in einer Pfanne erhitzen, die Filets leicht mit Mehl bestäuben und von beiden Seiten kurz anbraten, bis sie Farbe haben.",
          "timer_minutes": null
        },
        {
          "order": 4,
          "instruction": "Die angebratenen Filets aus der Pfanne nehmen und in eine feuerfeste Form legen.",
          "timer_minutes": null
        },
        {
          "order": 5,
          "instruction": "Zwiebeln schälen und klein hacken. Champignons putzen und vierteln.",
          "timer_minutes": null
        },
        {
          "order": 6,
          "instruction": "Zwiebeln und Champignons in der Pfanne anbraten, bis sie leicht gebräunt sind.",
          "timer_minutes": null
        },
        {
          "order": 7,
          "instruction": "Mit dem Wermut ablöschen, kurz einkochen lassen.",
          "timer_minutes": null
        },
        {
          "order": 8,
          "instruction": "Sahne angießen, den hellen Soßenbinder einrühren und die Sauce kurz aufkochen lassen. Mit Salz und Pfeffer abschmecken.",
          "timer_minutes": null
        },
        {
          "order": 9,
          "instruction": "Die Soße über die Hähnchenfilets in der Form gießen und alles im vorgeheizten Backofen bei 200 °C etwa 20 Minuten garen lassen.",
          "timer_minutes": 20
        },
        {
          "order": 10,
          "instruction": "Herausnehmen und heiß servieren. Als Beilage passen Pellkartoffeln und grüner Salat.",
          "timer_minutes": null
        }
      ]
    }
  ],
  "notes": "Als Beilage eignen sich Pellkartoffeln und ein grüner Salat. Die Garzeit kann je nach Ofen und Dicke der Filets leicht variieren.",

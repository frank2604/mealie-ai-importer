  "instructions": [
    {
      "name": null,
      "steps": [
        {
          "order": 1,
          "instruction": "Hähnchenbrustfilets mit Pfeffer würzen. Jeweils ein Salbeiblatt auf ein Filet legen und das Filet mit einer Scheibe Parma-Schinken umwickeln.",
          "timer_minutes": null
        },
        {
          "order": 2,
          "instruction": "Fett in einer Pfanne erhitzen. Die Filets leicht mit Mehl bestäuben und in der Pfanne rundherum anbraten, bis sie Farbe bekommen. Die angebratenen Filets herausnehmen und in eine feuerfeste Form legen.",
          "timer_minutes": null
        },
        {
          "order": 3,
          "instruction": "Zwiebeln schälen und klein hacken. Die Zwiebeln zusammen mit den geviertelten Champignons in der Pfanne anbraten, bis sie Farbe nehmen.",
          "timer_minutes": null
        },
        {
          "order": 4,
          "instruction": "Mit trockenem Wermut ablöschen, etwas einkochen lassen und dann die süße Sahne zugießen. Den hellen Soßenbinder einrühren, die Soße kurz aufkochen lassen und mit Salz und Pfeffer abschmecken.",
          "timer_minutes": null
        },
        {
          "order": 5,
          "instruction": "Die Sauce über die Hähnchenbrustfilets in der feuerfesten Form geben und alles im vorgeheizten Ofen bei 200 °C etwa 20 Minuten garen lassen.",
          "timer_minutes": 20
        },
        {
          "order": 6,
          "instruction": "Die Hähnchenbrustfilets aus dem Ofen nehmen und servieren. Dazu passen Pellkartoffeln und grüner Salat.",
          "timer_minutes": null
        }
      ]
    }
  ],
  "notes": "Ofentemperatur 200 °C, Garzeit im Ofen etwa 20 Minuten. Dazu passen Pellkartoffeln und grüner Salat.",

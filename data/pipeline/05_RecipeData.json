  "instructions": [
    {
      "name": null,
      "steps": [
        {
          "order": 1,
          "instruction": "Die Hähnchenbrustfilets mit Salz und Pfeffer würzen.",
          "timer_minutes": null
        },
        {
          "order": 2,
          "instruction": "Jeweils ein Salbeiblatt auf ein Filet legen und die Filets mit jeweils einer Scheibe Parma-Schinken umwickeln.",
          "timer_minutes": null
        },
        {
          "order": 3,
          "instruction": "Fett in einer Pfanne erhitzen. Die Filets leicht mit Mehl bestäuben und rundherum anbraten, bis sie Farbe bekommen.",
          "timer_minutes": null
        },
        {
          "order": 4,
          "instruction": "Die angebratenen Filets herausnehmen und in eine feuerfeste Form legen.",
          "timer_minutes": null
        },
        {
          "order": 5,
          "instruction": "Zwiebeln schälen und fein hacken. In derselben Pfanne Zwiebeln und die geputzten, geviertelten Champignons anbraten.",
          "timer_minutes": null
        },
        {
          "order": 6,
          "instruction": "Mit Wermut ablöschen und etwas einkochen lassen.",
          "timer_minutes": null
        },
        {
          "order": 7,
          "instruction": "Sahne angießen und den hellen Soßenbinder einrühren. Die Soße kurz aufkochen lassen und mit Salz und Pfeffer abschmecken.",
          "timer_minutes": null
        },
        {
          "order": 8,
          "instruction": "Die Soße über die Hähnchenbrustfilets in der feuerfesten Form geben.",
          "timer_minutes": null
        },
        {
          "order": 9,
          "instruction": "Die Form in den vorgeheizten Ofen bei 200 °C stellen und alles etwa 20 Minuten garen lassen, bis das Fleisch durchgegart ist.",
          "timer_minutes": 20
        },
        {
          "order": 10,
          "instruction": "Servieren Sie die Filets mit der Champignon-Sahnesoße. Dazu passen Pellkartoffeln und ein grüner Salat.",
          "timer_minutes": null
        }
      ]
    }
  ],
  "notes": "Dazu passen Pellkartoffeln und grüner Salat. Falls gewünscht, können Champignons zuvor mit etwas Knoblauch verfeinert werden.",

  "instructions": [
    {
      "name": "Zubereitung Ente mit 8 Kostbarkeiten",
      "steps": [
        {
          "id": "step-0-0",
          "order": 1,
          "instruction": "Die Morcheln und Tongu-Pilze in warmem Wasser einweichen.",
          "timer_minutes": null,
          "ingredientIds": [
            "ing-0-0",
            "ing-0-1"
          ],
          "ingredientReferenceIds": []
        },
        {
          "id": "step-0-1",
          "order": 2,
          "instruction": "Die Ente von Innereien, innerem Fett und dem Hals befreien, waschen und in Portionsstücke schneiden oder hacken. In einem Topf knapp mit kaltem Wasser bedecken, salzen, aufkochen und etwa 20 Minuten köcheln lassen. Die Ententeile dann herausheben, die Brühe abseihen und eventuell entfetten.",
          "timer_minutes": 20,
          "ingredientIds": [
            "ing-0-2"
          ],
          "ingredientReferenceIds": []
        },
        {
          "id": "step-0-2",
          "order": 3,
          "instruction": "Ingwer schälen und fein hacken, mit je 1/2 Teelöffel Salz, Fünfgewürzpulver und Pfeffer, der Hoisin- und der Sojasauce verrühren, die Ententeile damit gut einreiben.",
          "timer_minutes": null,
          "ingredientIds": [
            "ing-0-4",
            "ing-0-5",
            "ing-0-6",
            "ing-0-7",
            "ing-0-8",
            "ing-0-2"
          ],
          "ingredientReferenceIds": []
        },
        {
          "id": "step-0-3",
          "order": 4,
          "instruction": "Lotussamen und Wasserkastanien abtropfen lassen, mit Cashewkernen und Erbsen mischen. Morcheln von holzigen Stellen befreien und entstielen, Tongu-Pilze entstielen. Die Pilze in breite Streifen schneiden. Die Lilienknospen entstielen, quer halbieren, aus jeder Nadel einen Knoten machen.",
          "timer_minutes": null,
          "ingredientIds": [
            "ing-0-9",
            "ing-0-10",
            "ing-0-11",
            "ing-0-12",
            "ing-0-0",
            "ing-0-1",
            "ing-0-13"
          ],
          "ingredientReferenceIds": []
        },
        {
          "id": "step-0-4",
          "order": 5,
          "instruction": "Mit einem Messer möglichst viel Marinade von den Ententeilen abschaben und mit 50 ml Entenbrühe verrühren.",
          "timer_minutes": null,
          "ingredientIds": [
            "ing-0-2"
          ],
          "ingredientReferenceIds": []
        },
        {
          "id": "step-0-5",
          "order": 6,
          "instruction": "Das Öl im heißen Wok oder einer heißen breiten Pfanne erhitzen, die Ententeile rundherum braten. Pilze und die übrigen vorbereiteten Zutaten dazugeben, alles etwa 2 Minuten garen. Die Marinade einrühren, alles zugedeckt bei milder Hitze etwa 10 Minuten schmoren.",
          "timer_minutes": 12,
          "ingredientIds": [
            "ing-0-14",
            "ing-0-2",
            "ing-0-0",
            "ing-0-1",
            "ing-0-9",
            "ing-0-10",
            "ing-0-11",
            "ing-0-12"
          ],
          "ingredientReferenceIds": []
        },
        {
          "id": "step-0-6",
          "order": 7,
          "instruction": "Datteln und Pflaumen entsteinen, halbieren und in den Wok oder die Pfanne geben, alles verrühren und zugedeckt noch etwa 10 Minuten schmoren.",
          "timer_minutes": 10,
          "ingredientIds": [
            "ing-0-15",
            "ing-0-16"
          ],
          "ingredientReferenceIds": []
        },
        {
          "id": "step-0-7",
          "order": 8,
          "instruction": "Die Ententeile herausheben, mit den übrigen Zutaten anrichten. Den Wok (Pfanne) wieder erhitzen, etwa 140 ml Entenbrühe angießen. Die Speisestärke mit Reiswein glatt rühren, die Sauce damit binden. Abschmecken, über die Ententeile träufeln.",
          "timer_minutes": null,
          "ingredientIds": [
            "ing-0-17",
            "ing-0-18"
          ],
          "ingredientReferenceIds": []
        }
      ]
    }
  ],
  "notes": "Wenn Sie nicht alle Zutaten bekommen, servieren Sie Ente mit vier oder mit sechs Kostbarkeiten.",

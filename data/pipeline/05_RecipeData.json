  "instructions": [
    {
      "name": null,
      "steps": [
        {
          "order": 1,
          "instruction": "Hähnchenbrustfilets mit Pfeffer würzen.",
          "timer_minutes": null
        },
        {
          "order": 2,
          "instruction": "Jeweils ein Salbeiblatt auf ein Filet legen und die Filets mit Parma-Schinken umwickeln.",
          "timer_minutes": null
        },
        {
          "order": 3,
          "instruction": "Fett in einer Pfanne erhitzen, die Filets leicht mit Mehl bestäuben und von beiden Seiten anbraten, bis sie Farbe haben.",
          "timer_minutes": null
        },
        {
          "order": 4,
          "instruction": "Die angebratenen Filets herausnehmen und in eine feuerfeste Form legen.",
          "timer_minutes": null
        },
        {
          "order": 5,
          "instruction": "Zwiebeln schälen und kleinhacken; zusammen mit den geputzten und geviertelten Champignons in der Pfanne anbraten.",
          "timer_minutes": null
        },
        {
          "order": 6,
          "instruction": "Mit Wermut ablöschen und etwas einkochen lassen, dann die süße Sahne zugeben.",
          "timer_minutes": null
        },
        {
          "order": 7,
          "instruction": "Einen Esslöffel hellen Soßenbinder einrühren, die Sauce kurz aufkochen lassen und mit Salz und Pfeffer abschmecken.",
          "timer_minutes": null
        },
        {
          "order": 8,
          "instruction": "Die Sauce über das Fleisch in der Form gießen und alles im vorgeheizten Ofen bei 200 °C etwa 20 Minuten garen lassen.",
          "timer_minutes": 20
        },
        {
          "order": 9,
          "instruction": "Aus dem Ofen nehmen und heiß servieren. Dazu passen Pellkartoffeln und grüner Salat.",
          "timer_minutes": null
        }
      ]
    }
  ],
  "notes": "Ofen auf 200 °C vorheizen. Mengenangaben nach Geschmack anpassen. Optional frische Petersilie zum Servieren.",

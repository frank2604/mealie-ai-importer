  "instructions": [
    {
      "name": null,
      "steps": [
        {
          "order": 1,
          "instruction": "Die Hähnchenbrustfilets mit Pfeffer würzen. Jeweils ein Salbeiblatt auf das Filet legen und mit einer Scheibe Parma-Schinken umwickeln.",
          "timer_minutes": null
        },
        {
          "order": 2,
          "instruction": "Fett in einer Pfanne erhitzen, die Filets mit Mehl bestäuben und von allen Seiten anbraten, bis sie Farbe bekommen. Die Filets herausnehmen und in eine feuerfeste Form legen.",
          "timer_minutes": null
        },
        {
          "order": 3,
          "instruction": "Zwiebeln schälen und klein hacken. Zusammen mit den geputzten und geviertelten Champignons in der Pfanne anbraten.",
          "timer_minutes": null
        },
        {
          "order": 4,
          "instruction": "Mit trockenem Wermut ablöschen, etwas einkochen lassen. Süße Sahne angießen und den hellen Soßenbinder einrühren. Kurz aufkochen lassen und die Sauce mit Salz und Pfeffer abschmecken.",
          "timer_minutes": null
        },
        {
          "order": 5,
          "instruction": "Die Sauce über die in der Form liegenden Filets gießen und alles im vorgeheizten Backofen bei 200°C etwa 20 Minuten garen lassen.",
          "timer_minutes": 20
        },
        {
          "order": 6,
          "instruction": "Die Hähnchenbrüste aus dem Ofen nehmen und servieren. Dazu passen Pellkartoffeln und grüner Salat.",
          "timer_minutes": null
        }
      ]
    }
  ],
  "notes": "Dazu passen Pellkartoffeln und grüner Salat.",

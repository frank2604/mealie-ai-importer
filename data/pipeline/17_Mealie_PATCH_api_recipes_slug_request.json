  "recipeInstructions": [
    {
      "id": "de1f438c-3e13-4019-a5da-f894479d8231",
      "text": "Hähnchenbrustfilets mit Salz und Pfeffer würzen. Jeweils ein Salbeiblatt auf die Filets legen und mit einer oder mehreren Scheiben Parma-Schinken umwickeln.",
      "order": 1,
      "ingredientReferences": []
    },
    {
      "id": "47707974-0858-4788-91af-95e89f6d4431",
      "text": "Fett in einer Pfanne erhitzen. Die Filets leicht mit Mehl bestäuben und von beiden Seiten anbraten, bis sie Farbe nehmen. Herausnehmen und in eine feuerfeste Form legen.",
      "order": 2,
      "ingredientReferences": []
    },
    {
      "id": "94420a79-d81b-4855-ac08-4a56bb98a092",
      "text": "Zwiebeln schälen und kleinhacken. In derselben Pfanne Zwiebeln und die geviertelten Champignons anbraten, bis sie leicht gebräunt sind.",
      "order": 3,
      "ingredientReferences": []
    },
    {
      "id": "6c7cce78-c092-431d-86ab-095329e54b8d",
      "text": "Mit dem trockenen Wermut ablöschen, etwas einkochen lassen und dann die süße Sahne zugießen. Den hellen Soßenbinder einrühren, die Soße kurz aufkochen lassen und mit Salz und Pfeffer abschmecken.",
      "order": 4,
      "ingredientReferences": []
    },
    {
      "id": "9e2aac9e-1f9b-4c31-bfaf-56d362236551",
      "text": "Die Soße über die Hähnchenfilets in der feuerfesten Form geben. Im vorgeheizten Backofen bei 200 °C etwa 20 Minuten garen lassen.",
      "order": 5,
      "ingredientReferences": [],
      "timerMinutes": 20
    },
    {
      "id": "a26a69a1-41c8-487d-850d-9529bcd77607",
      "text": "Aus dem Ofen nehmen und servieren. Dazu passen Pellkartoffeln und grüner Salat.",
      "order": 6,
      "ingredientReferences": []
    }
  ]
}
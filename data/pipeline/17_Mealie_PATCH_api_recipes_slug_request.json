      "id": "3ce638cd-b4e0-4739-b72b-8c5085b96d49",
      "title": "Zubereitung",
      "text": "Fett in einer Pfanne erhitzen. Die Filets leicht mit Mehl bestäuben und in der Pfanne rundherum anbraten, bis sie Farbe bekommen.",
      "order": 3,
      "ingredientReferences": [
        {
          "referenceId": "b9f2811b-7bf8-4fe7-b2ce-442c2b3def2a"
        }
      ]
    },
    {
      "id": "2d6b857d-52e5-421c-9f78-b39c1eaad9aa",
      "title": "Zubereitung",
      "text": "Die angebratenen Filets aus der Pfanne nehmen und in eine feuerfeste Form geben.",
      "order": 4,
      "ingredientReferences": []
    },
    {
      "id": "d33c6482-160a-41e3-b5b6-749632bbd35f",
      "title": "Zubereitung",
      "text": "Zwiebeln schälen und klein hacken. In derselben Pfanne die Zwiebeln zusammen mit den geputzten und geviertelten Champignons anbraten.",
      "order": 5,
      "ingredientReferences": [
        {
          "referenceId": "9b74d86b-4009-4593-8b19-edbb04bf3d1a"
        }
      ]
    },
    {
      "id": "f4db7b7d-de51-4af9-a41a-b2843f9876cd",
      "title": "Zubereitung",
      "text": "Mit Wermut ablöschen, etwas einkochen lassen und dann die süße Sahne zugießen.",
      "order": 6,
      "ingredientReferences": [
        {
          "referenceId": "6903916b-25a7-4219-bcc6-d2140737714b"
        }
      ]
    },
    {
      "id": "31b3f0b0-cb0d-4c63-9e08-8d2044a2f58f",
      "title": "Zubereitung",
      "text": "Den hellen Soßenbinder einrühren, die Soße kurz aufkochen lassen und mit Salz und Pfeffer abschmecken.",
      "order": 7,
      "ingredientReferences": [
        {
          "referenceId": "2390ccc6-df0a-447e-a66d-589cfecbbd5c"
        },
        {
          "referenceId": "d3d35c86-7367-4f21-99c1-6f4946456ab6"
        }
      ]
    },
    {
      "id": "d16768ab-7897-43db-9e9c-06d36e99553c",
      "title": "Zubereitung",
      "text": "Die Soße über die Filets in der feuerfesten Form gießen.",
      "order": 8,
      "ingredientReferences": []
    },
    {
      "id": "b5228bc9-d345-40fe-a709-fa5321ccdee9",
      "title": "Zubereitung",
      "text": "Die Form in den vorgeheizten Backofen geben und alles bei 200 °C etwa 20 Minuten garen lassen, bis das Fleisch durch ist.",
      "order": 9,
      "ingredientReferences": [],
      "timerMinutes": 20
    },
    {
      "id": "506e3f1e-e170-43f7-9adf-782e836eecdf",
      "title": "Zubereitung",
      "text": "Die Filets aus dem Ofen nehmen und heiß servieren. Dazu passen Pellkartoffeln und grüner Salat.",
      "order": 10,
      "ingredientReferences": []
    }
  ]
}
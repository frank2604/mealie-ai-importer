    "recipeInstructions": [
      {
        "id": "03e6ca68-48e2-411d-b47d-5cedfee99d8e",
        "title": null,
        "summary": null,
        "text": "Hähnchenbrustfilets mit Pfeffer würzen. Jeweils ein Salbeiblatt auflegen und die Filets mit Parma-Schinken umwickeln.",
        "ingredientReferences": []
      },
      {
        "id": "69f2fa75-bcf5-44ca-9fd8-62da0f8a8977",
        "title": null,
        "summary": null,
        "text": "Fett in einer Pfanne erhitzen. Die Filets leicht mit Mehl bestäuben und in der Pfanne rundherum anbraten, bis sie Farbe haben. Herausnehmen und in eine feuerfeste Form legen.",
        "ingredientReferences": []
      },
      {
        "id": "d592cc0f-c351-4043-b3f8-ec7b335fdf83",
        "title": null,
        "summary": null,
        "text": "Zwiebeln schälen und klein hacken. Zusammen mit den geviertelten Champignons in der Pfanne anbraten.",
        "ingredientReferences": []
      },
      {
        "id": "cc73a122-10da-4461-b6bb-cc2c569617ef",
        "title": null,
        "summary": null,
        "text": "Mit Wermut ablöschen, kurz einkochen lassen und dann die süße Sahne zugießen. Den hellen Soßenbinder einrühren, die Soße kurz aufkochen lassen und mit Salz und Pfeffer abschmecken.",
        "ingredientReferences": []
      },
      {
        "id": "54d92987-e910-461e-8ec3-175d045dcb69",
        "title": null,
        "summary": null,
        "text": "Die Soße über die Filets in der Auflaufform gießen und alles im vorgeheizten Ofen bei 200° C etwa 20 Minuten garen lassen.",
        "ingredientReferences": []
      },
      {
        "id": "dcedde57-6b87-442b-be12-55dba4f3ce98",
        "title": null,
        "summary": null,
        "text": "Als Beilage passen Pellkartoffeln und ein grüner Salat.",
        "ingredientReferences": []
      }
    ],

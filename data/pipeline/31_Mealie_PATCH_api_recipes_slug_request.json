  "recipeInstructions": [
    {
      "id": "d2ad38be-df8a-47c9-9044-05f616ef4c6d",
      "title": "Zubereitung Ente mit 8 Kostbarkeiten",
      "text": "Die Morcheln und Tongu-Pilze in warmem Wasser einweichen.",
      "order": 1,
      "ingredientReferences": [
        {
          "referenceId": "97adc59d-1702-4cd1-9c58-93e9a0068bf9"
        },
        {
          "referenceId": "01d757f0-e5f8-4e03-8849-99e17f7bbc20"
        }
      ]
    },
    {
      "id": "81952f4c-05d3-47ed-b553-2c7d84bcf5fc",
      "title": "Zubereitung Ente mit 8 Kostbarkeiten",
      "text": "Die Ente von Innereien, innerem Fett und dem Hals befreien, waschen und in Portionsstücke schneiden oder hacken. In einem Topf knapp mit kaltem Wasser bedecken, salzen, aufkochen und etwa 20 Minuten köcheln lassen. Die Ententeile dann herausheben, die Brühe abseihen und eventuell entfetten.",
      "order": 2,
      "ingredientReferences": [
        {
          "referenceId": "671aae5f-5631-4d1a-b45a-8168f4bbedb2"
        }
      ],
      "timerMinutes": 20
    },
    {
      "id": "fc60b182-1e3e-4bcc-b04d-6c6a098d0ec5",
      "title": "Zubereitung Ente mit 8 Kostbarkeiten",
      "text": "Ingwer schälen und fein hacken, mit je 1/2 Teelöffel Salz, Fünfgewürzpulver und Pfeffer, der Hoisin- und der Sojasauce verrühren, die Ententeile damit gut einreiben.",
      "order": 3,
      "ingredientReferences": [
        {
          "referenceId": "9e692640-5e83-44dc-b3b9-8597eb356c2c"
        },
        {
          "referenceId": "ac1edee7-a057-4e2b-b904-fb25445e0081"
        },
        {
          "referenceId": "88492d80-5db0-4409-bc79-e78b1433c6b4"
        },
        {
          "referenceId": "57d1819c-594c-4ac6-a359-fa653db94711"
        },
        {
          "referenceId": "611c2906-578a-46a6-8900-e3f1f5394e84"
        },
        {
          "referenceId": "671aae5f-5631-4d1a-b45a-8168f4bbedb2"
        }
      ]
    },
    {
      "id": "2b9d73b8-e3e6-496e-991f-27b366203d9c",
      "title": "Zubereitung Ente mit 8 Kostbarkeiten",
      "text": "Lotussamen und Wasserkastanien abtropfen lassen, mit Cashewkernen und Erbsen mischen. Morcheln von holzigen Stellen befreien und entstielen, Tongu-Pilze entstielen. Die Pilze in breite Streifen schneiden. Die Lilienknospen entstielen, quer halbieren, aus jeder Nadel einen Knoten machen.",
      "order": 4,
      "ingredientReferences": [
        {
          "referenceId": "01a26ab1-3999-4ca0-ae30-f25a89f2ef2c"
        },
        {
          "referenceId": "e51eaf20-d689-4e69-ac06-f374eaaa59d2"
        },
        {
          "referenceId": "842ece89-ae99-4e10-bb57-7145bcd1b1bd"
        },
        {
          "referenceId": "0af238fb-462e-4634-ae74-70798f359e85"
        },
        {
          "referenceId": "97adc59d-1702-4cd1-9c58-93e9a0068bf9"
        },
        {
          "referenceId": "01d757f0-e5f8-4e03-8849-99e17f7bbc20"
        },
        {
          "referenceId": "5e21b815-9337-44f9-9395-8088472e0dbd"
        }
      ]
    },
    {
      "id": "69b21a3f-5896-4fdf-ac20-4788af7b5ee8",
      "title": "Zubereitung Ente mit 8 Kostbarkeiten",
      "text": "Mit einem Messer möglichst viel Marinade von den Ententeilen abschaben und mit 50 ml Entenbrühe verrühren.",
      "order": 5,
      "ingredientReferences": [
        {
          "referenceId": "671aae5f-5631-4d1a-b45a-8168f4bbedb2"
        }
      ]
    },
    {
      "id": "4ea4b103-dbc2-4615-9fcf-aeedb1364595",
      "title": "Zubereitung Ente mit 8 Kostbarkeiten",
      "text": "Das Öl im heißen Wok oder einer heißen breiten Pfanne erhitzen, die Ententeile rundherum braten. Pilze und die übrigen vorbereiteten Zutaten dazugeben, alles etwa 2 Minuten garen. Die Marinade einrühren, alles zugedeckt bei milder Hitze etwa 10 Minuten schmoren.",
      "order": 6,
      "ingredientReferences": [
        {
          "referenceId": "84d98426-8560-4158-b79d-aa7d5f0c54dc"
        },
        {
          "referenceId": "671aae5f-5631-4d1a-b45a-8168f4bbedb2"
        },
        {
          "referenceId": "97adc59d-1702-4cd1-9c58-93e9a0068bf9"
        },
        {
          "referenceId": "01d757f0-e5f8-4e03-8849-99e17f7bbc20"
        },
        {
          "referenceId": "01a26ab1-3999-4ca0-ae30-f25a89f2ef2c"
        },
        {
          "referenceId": "e51eaf20-d689-4e69-ac06-f374eaaa59d2"
        },
        {
          "referenceId": "842ece89-ae99-4e10-bb57-7145bcd1b1bd"
        },
        {
          "referenceId": "0af238fb-462e-4634-ae74-70798f359e85"
        }
      ],
      "timerMinutes": 12
    },
    {
      "id": "60324aed-2e23-4e06-90c1-6f586d4d9bc6",
      "title": "Zubereitung Ente mit 8 Kostbarkeiten",
      "text": "Datteln und Pflaumen entsteinen, halbieren und in den Wok oder die Pfanne geben, alles verrühren und zugedeckt noch etwa 10 Minuten schmoren.",
      "order": 7,
      "ingredientReferences": [
        {
          "referenceId": "b4ed0781-13b0-43f8-89ae-a5e6243425e9"
        },
        {
          "referenceId": "10aee3b6-93db-4bdc-8e6b-7fed4663488b"
        }
      ],
      "timerMinutes": 10
    },
    {
      "id": "614c4338-facd-49bf-8adc-1e1372ed7e4c",
      "title": "Zubereitung Ente mit 8 Kostbarkeiten",
      "text": "Die Ententeile herausheben, mit den übrigen Zutaten anrichten. Den Wok (Pfanne) wieder erhitzen, etwa 140 ml Entenbrühe angießen. Die Speisestärke mit Reiswein glatt rühren, die Sauce damit binden. Abschmecken, über die Ententeile träufeln.",
      "order": 8,
      "ingredientReferences": [
        {
          "referenceId": "815b3304-2336-4b56-8fcf-0caa11e0e16b"
        },
        {
          "referenceId": "cf32bf0f-c917-42f4-87fd-18c74f9cb74b"
        }
      ]
    }
  ]
